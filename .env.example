# Copy to .env and fill in. .env is git-ignored.
# In production on cPanel, prefer setting these in the Python App "Environment
# variables" UI instead of a file.

DJANGO_SETTINGS_MODULE=config.settings.development

# Required in production (config.settings.production raises without it):
SECRET_KEY=change-me-generate-a-50-char-random-string
DEBUG=0
ALLOWED_HOSTS=subursedayamaju.co.id,www.subursedayamaju.co.id

# SQLite location (absolute path on the server, e.g. /home/<user>/app/db.sqlite3)
SQLITE_PATH=

# Contact form
CONTACT_EMAIL=admin@subursedayamaju.co.id

# SEO / analytics
# Origin for canonical URLs, Open Graph and JSON-LD (no trailing slash).
CANONICAL_HOST=https://www.subursedayamaju.co.id
# Leave both blank to disable analytics. Set one (or both) to enable.
GA4_MEASUREMENT_ID=
PLAUSIBLE_DOMAIN=

# Email sending (leave EMAIL_BACKEND unset locally to print to console)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.subursedayamaju.co.id
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_HOST_USER=no-reply@subursedayamaju.co.id
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=PT Subur Sedaya Maju <no-reply@subursedayamaju.co.id>
